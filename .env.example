# Copy this file to .env and fill in real values.
# Loaded automatically via python-dotenv (archrag/config.py, archrag/mcp_server.py).

# Required only if config.yaml selects `adapter: openai` for embedding
# and/or llm (the tracked config.yaml does, by default). Get a key at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional. Path to the config YAML used by the MCP server
# (archrag/mcp_server.py). Defaults to config.yaml in the project root.
# ARCHRAG_CONFIG=config.yaml

# Optional. Seconds between automatic ingestion-queue flushes in the MCP
# server's IngestionQueue. Defaults to 180.
# ARCHRAG_FLUSH_INTERVAL=180
